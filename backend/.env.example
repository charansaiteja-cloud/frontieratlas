# FrontierAtlas Environment Configuration Example
# Copy this file to .env and fill in actual values never commit real secrets!

# Application
FA_APP_NAME="FrontierAtlas"
FA_APP_VERSION="1.0.0"
FA_DEBUG="false"
FA_HOST="0.0.0.0"
FA_PORT="8000"

# Database
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5434/frontieratlas"
REDIS_URL="redis://localhost:6379/0"

# API Keys (never commit real values — use placeholder secrets only)
GEMINI_API_KEY="${GEMINI_API_KEY:-PLACEHOLDER_GEMINI_KEY}"
GROQ_API_KEY="${GROQ_API_KEY:-PLACEHOLDER_GROQ_KEY}"
DEEPSEEK_API_KEY="${DEEPSEEK_API_KEY:-PLACEHOLDER_DEEPSEEK_KEY}"
GITHUB_TOKEN="${GITHUB_TOKEN:-PLACEHOLDER_GITHUB_TOKEN}"

# LLM Configuration
FA_GEMINI_API_BASE="https://generativelanguage.googleapis.com/v1beta"
FA_Groq_API_BASE="https://api.groq.com/openai/v1"
FA_DeepSeek_API_BASE="https://api.deepseek.com/v1"

# Concurrency and Timeouts
FA_MAX_CONCURRENCY="10"
FA_PER_DOMAIN_CONCURRENCY="2"
FA_REQUEST_TIMEOUT="30"
FA_MAX_RETRIES="3"

# LLM Settings
FA_LLM_MAX_TOKENS="8192"
FA_LLM_TEMPERATURE="0.1"
FA_LLM_PROVIDER_TIMEOUT="60"

# Freshness Window
FA_FRESH_WINDOW_HOURS="24"

# API Registry
FA_SEED_ENTITIES="scripts/seed_entities.py"

# CORS
FA_CORS_ORIGINS="http://localhost:3000,http://localhost:3001"